NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Must be selected from authenticated GET /api/models; no fabricated default.
NEBIUS_MODEL_ID=
NEBIUS_BUDGET_LIMIT_USD=25
NEBIUS_MAX_OUTPUT_TOKENS=2048
NEBIUS_REQUEST_TIMEOUT=60
# Set to verified account/model prices; paid requests are blocked until configured.
NEBIUS_INPUT_USD_PER_MILLION=
NEBIUS_OUTPUT_USD_PER_MILLION=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for paid AI routes in a public deployment. Enter via the lab's connection panel.
LAB_ACCESS_TOKEN=
LAB_ENV=development
LAB_DATA_DIR=.runtime
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
